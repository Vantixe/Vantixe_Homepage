# Copy this file to .env.local and fill in the values. .env.local is gitignored.

# Resend (https://resend.com): vantixe.com must be a verified sending domain
RESEND_API_KEY=

# Inquiry form addressing
CONTACT_FROM_EMAIL=Vantixe <contact@vantixe.com>
CONTACT_TO_EMAIL=hello@vantixe.com

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
# Optional: if both are blank the form falls back to honeypot-only spam protection.
# The production keys are bound to vantixe.com and vantixe.ai and never work on localhost.
# For local testing use the Cloudflare dummy keys (widget always passes, siteverify always succeeds):
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Tag Manager (https://tagmanager.google.com → container ID, format GTM-XXXXXXX)
# Optional: if blank, no tracking loads and the site behaves exactly as before.
# One value covers BOTH vantixe.com and vantixe.ai (same deployment).
NEXT_PUBLIC_GTM_ID=

# LinkedIn Insight Tag partner id (Campaign Manager → Analyze → Insight Tag).
# Production only: leave blank locally so development never sends traffic to LinkedIn.
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# Optional event-specific LinkedIn conversion fired on /book (Campaign Manager → Conversions,
# "event-specific" type, copy the conversion_id). The page-load rules "URL contains /thank-you"
# and "URL contains /book" do the counting; this is an extra signal. Production only.
NEXT_PUBLIC_LINKEDIN_BOOKING_CONVERSION_ID=
